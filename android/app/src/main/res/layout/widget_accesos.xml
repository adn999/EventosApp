<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fondo"
    android:padding="10dp">

<!-- Logo grande y atenuado detrás de todo -->
<ImageView
    android:layout_width="170dp"
    android:layout_height="170dp"
    android:layout_gravity="end|center_vertical"
    android:layout_marginEnd="-30dp"
    android:alpha="0.16"
    android:src="@drawable/logo_scout" />

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- KPIs: toda la zona abre la pantalla de indicadores -->
    <LinearLayout
        android:id="@+id/zona_kpis"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/fila_kpis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout style="@style/WidgetKpi">
                <TextView style="@style/WidgetKpiTitulo" android:text="Asistencia" />
                <FrameLayout android:layout_width="52dp" android:layout_height="52dp">
                    <ImageView android:id="@+id/asistencia_anillo" android:layout_width="match_parent" android:layout_height="match_parent" />
                    <TextView android:id="@+id/asistencia_valor" style="@style/WidgetKpiValor" android:layout_gravity="center"
                        android:textColor="#4E6129" android:textSize="16sp" />
                </FrameLayout>
                <TextView android:id="@+id/asistencia_total" style="@style/WidgetKpiTotal" />
            </LinearLayout>

            <LinearLayout style="@style/WidgetKpi">
                <TextView style="@style/WidgetKpiTitulo" android:text="Kits" />
                <FrameLayout android:layout_width="52dp" android:layout_height="52dp">
                    <ImageView android:id="@+id/kits_anillo" android:layout_width="match_parent" android:layout_height="match_parent" />
                    <TextView android:id="@+id/kits_valor" style="@style/WidgetKpiValor" android:layout_gravity="center"
                        android:textColor="#347D5F" android:textSize="16sp" />
                </FrameLayout>
                <TextView android:id="@+id/kits_total" style="@style/WidgetKpiTotal" />
            </LinearLayout>

            <LinearLayout style="@style/WidgetKpi">
                <TextView style="@style/WidgetKpiTitulo" android:text="Comidas" />
                <FrameLayout android:layout_width="52dp" android:layout_height="52dp">
                    <ImageView android:id="@+id/comidas_anillo" android:layout_width="match_parent" android:layout_height="match_parent" />
                    <TextView android:id="@+id/comidas_valor" style="@style/WidgetKpiValor" android:layout_gravity="center"
                        android:textColor="#AF591C" android:textSize="16sp" />
                </FrameLayout>
                <TextView style="@style/WidgetKpiTotal" android:text=" " />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pie_fila"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
            android:id="@+id/pie"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#666666"
            android:textSize="9sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/sin_datos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Abre la app para ver los indicadores"
            android:textColor="#666666"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Accesos directos -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <LinearLayout android:id="@+id/boton_registro" style="@style/WidgetBoton">
            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_widget_registro" />
            <TextView style="@style/WidgetBotonTexto" android:text="Registro" />
        </LinearLayout>

        <LinearLayout android:id="@+id/boton_kit" style="@style/WidgetBoton">
            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_widget_kit" />
            <TextView style="@style/WidgetBotonTexto" android:text="Kit" />
        </LinearLayout>

        <LinearLayout android:id="@+id/boton_consulta" style="@style/WidgetBoton">
            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_widget_consulta" />
            <TextView style="@style/WidgetBotonTexto" android:text="Consulta" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
</FrameLayout>
